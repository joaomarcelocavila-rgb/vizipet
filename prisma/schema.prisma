generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TUTOR
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETION_PENDING
  DELETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED_BY_TUTOR
  CANCELLED_BY_PROVIDER
  COMPLETED
}

enum Modality {
  IN_PERSON
  REMOTE
}

enum CampaignStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ENDED
  ARCHIVED
}

enum SourceStatus {
  VALID
  UNREACHABLE
  OUTDATED
  NOT_CHECKED
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum VerificationTarget {
  CLINIC
  PROFESSIONAL
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum DocumentKind {
  CRMV
  IDENTITY
  CLINIC_LICENSE
  OTHER
}

// ---------------------------------------------------------------- José

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  phone        String?
  role         UserRole   @default(TUTOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  pets                    Pet[]
  professional            Professional?
  appointments            Appointment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  idempotencyKeys         IdempotencyKey[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset_tokens")
}

model Species {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  pets     Pet[]
  services ServiceSpecies[]

  @@map("species")
}

model Pet {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  speciesId   String    @map("species_id") @db.Uuid
  name        String
  breed       String?
  sex         PetSex    @default(UNKNOWN)
  birthDate   DateTime? @map("birth_date") @db.Date
  weightGrams Int?      @map("weight_grams")
  photoPath   String?   @map("photo_path")
  notes       String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  species      Species       @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([ownerId])
  @@map("pets")
}

model LegalAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  document   String
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("legal_acceptances")
}

model PrivacyRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  kind        String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("privacy_requests")
}

model NotificationPreference {
  userId               String  @id @map("user_id") @db.Uuid
  emailEnabled         Boolean @default(true) @map("email_enabled")
  appointmentReminders Boolean @default(true) @map("appointment_reminders")
  campaignUpdates      Boolean @default(true) @map("campaign_updates")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// --------------------------------------------------------------- Pedro

model Clinic {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String?            @map("owner_id") @db.Uuid
  name               String
  description        String?
  phone              String?
  addressLine        String             @map("address_line")
  neighborhood       String
  city               String
  state              String
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  responsibleVet     String?            @map("responsible_vet")
  responsibleCrmv    String?            @map("responsible_crmv")
  // Atende urgências 24 horas. Aparece na tela de emergência do app.
  emergency24h       Boolean            @default(false) @map("emergency_24h")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  // Última versão aprovada. A busca pública lê apenas este snapshot.
  publicProfile      Json?              @map("public_profile")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  professionals ClinicProfessional[]
  slots         AvailabilitySlot[]
  appointments  Appointment[]
  documents     VerificationDocument[]

  @@index([verificationStatus, city, neighborhood])
  @@map("clinics")
}

model Professional {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  displayName        String             @map("display_name")
  specialty          String?
  bio                String?
  crmvNumber         String             @map("crmv_number")
  crmvState          String             @map("crmv_state")
  city               String?
  neighborhood       String?
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  publicProfile      Json?              @map("public_profile")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinics      ClinicProfessional[]
  services     ServiceProfessional[]
  slots        AvailabilitySlot[]
  appointments Appointment[]
  documents    VerificationDocument[]

  @@unique([crmvNumber, crmvState])
  @@index([verificationStatus])
  @@map("professionals")
}

model ClinicProfessional {
  clinicId       String   @map("clinic_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([clinicId, professionalId])
  @@map("clinic_professionals")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  name            String
  description     String?
  modality        Modality
  durationMinutes Int      @map("duration_minutes")
  priceCents      Int?     @map("price_cents")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  professionals ServiceProfessional[]
  species       ServiceSpecies[]
  slots         AvailabilitySlot[]
  appointments  Appointment[]

  @@index([active, modality])
  @@map("services")
}

model ServiceSpecies {
  serviceId String @map("service_id") @db.Uuid
  speciesId String @map("species_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  species Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([serviceId, speciesId])
  @@map("service_species")
}

model ServiceProfessional {
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@map("service_professionals")
}

model AvailabilitySlot {
  id             String     @id @default(uuid()) @db.Uuid
  professionalId String     @map("professional_id") @db.Uuid
  serviceId      String     @map("service_id") @db.Uuid
  clinicId       String?    @map("clinic_id") @db.Uuid
  startsAt       DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime   @map("ends_at") @db.Timestamptz(6)
  status         SlotStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  // A constraint de início < término e a exclusão de sobreposição por
  // profissional estão na migration (Prisma não modela CHECK/EXCLUDE).
  @@index([status, startsAt])
  @@index([professionalId, startsAt])
  @@map("availability_slots")
}

model VerificationDocument {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String?      @map("professional_id") @db.Uuid
  clinicId       String?      @map("clinic_id") @db.Uuid
  kind           DocumentKind
  storagePath    String       @map("storage_path")
  originalName   String       @map("original_name")
  mimeType       String       @map("mime_type")
  sizeBytes      Int          @map("size_bytes")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

// ----------------------------------------------------------- Guilherme

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  tutorId        String            @map("tutor_id") @db.Uuid
  petId          String            @map("pet_id") @db.Uuid
  professionalId String            @map("professional_id") @db.Uuid
  serviceId      String            @map("service_id") @db.Uuid
  clinicId       String?           @map("clinic_id") @db.Uuid
  slotId         String            @map("slot_id") @db.Uuid
  status         AppointmentStatus @default(CONFIRMED)
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime          @map("ends_at") @db.Timestamptz(6)
  snapshot       Json
  cancelReason   String?           @map("cancel_reason")
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tutor        User             @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  pet          Pet              @relation(fields: [petId], references: [id], onDelete: Restrict)
  professional Professional     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clinic       Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  slot         AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  // Índice único parcial (slot_id onde status = CONFIRMED) criado na migration.
  @@index([tutorId, startsAt])
  @@index([professionalId, startsAt])
  @@index([slotId])
  @@map("appointments")
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  type            String
  organization    String
  audience        String
  requirements    String
  location        String
  startsAt        DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime       @map("ends_at") @db.Timestamptz(6)
  sourceUrl       String         @map("source_url")
  sourceStatus    SourceStatus   @default(NOT_CHECKED) @map("source_status")
  sourceCheckedAt DateTime?      @map("source_checked_at") @db.Timestamptz(6)
  status          CampaignStatus @default(DRAFT)
  verifiedById    String?        @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?      @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, endsAt])
  @@map("campaigns")
}

model Notification {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  channel          NotificationChannel @default(IN_APP)
  type             String
  title            String
  body             String
  deduplicationKey String              @unique @map("deduplication_key")
  readAt           DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  dedupKey      String?      @unique @map("dedup_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model VerificationRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  target         VerificationTarget
  professionalId String?                   @map("professional_id") @db.Uuid
  clinicId       String?                   @map("clinic_id") @db.Uuid
  status         VerificationRequestStatus @default(PENDING)
  decidedById    String?                   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?                 @map("decided_at") @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("verification_requests")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  operation String
  key       String
  response  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@map("idempotency_keys")
}
