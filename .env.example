NODE_ENV=development
LOG_LEVEL=log
PORT=3000

DATABASE_URL=postgresql://vizipet:vizipet@localhost:5432/vizipet
DIRECT_URL=postgresql://vizipet:vizipet@localhost:5432/vizipet

JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo-e-aleatorio

APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# local (disco, para dev/teste) ou supabase (bucket privado)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vizipet-private

# Sem chave o e-mail não é enviado (só registra o assunto no log)
RESEND_API_KEY=
MAIL_FROM=Vizipet <nao-responda@vizipet.local>

CRON_SECRET=troque-por-um-segredo-para-o-cron
# true liga um timer interno (a cada 60 s) para outbox, lembretes e campanhas
INTERNAL_JOBS=false
THROTTLE_LIMIT=120
